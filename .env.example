# ==============================================================================
# REPUESTOS AUTOMOTRICES ASUNCIÓN - CONFIGURACIÓN DE ENTORNO (.env.example)
# Copiar a .env para personalizar credenciales en Docker Compose o Producción
# ==============================================================================

# --- Perfil Spring Boot (dev = ejecución local inmediata | docker = PostGIS + MinIO) ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# --- PostgreSQL 16 + PostGIS 3.4 ---
DB_HOST=postgres-postgis
DB_PORT=5432
DB_NAME=asuncion_erp
DB_USER=asuncion_admin
DB_PASSWORD=tu_contrasena_de_base_de_datos

# --- Seguridad JWT Stateless (Mínimo 256 bits / 32+ caracteres) ---
JWT_SECRET=tu_clave_secreta_jwt_minimo_32_caracteres_aleatorios
JWT_EXPIRATION_SECONDS=86400

# --- Almacenamiento Multimedia S3 / MinIO ---
STORAGE_TYPE=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000/asuncion-media
S3_REGION=us-east-1
S3_BUCKET=asuncion-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=tu_clave_secreta_minio

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://127.0.0.1:4200

# --- Google Maps Platform API (Maps JS, Places, Geometry) ---
GOOGLE_MAPS_API_KEY=

# --- Conector Opcional IA Conversacional (Google Gemini API) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
